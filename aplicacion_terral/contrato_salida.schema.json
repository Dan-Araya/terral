{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terral G1 salida 1.0",
  "type": "object",
  "required": ["version_contrato", "modo", "modelo", "modelo_sha256", "estaciones", "hora_observacion_original", "adquisicion_utc", "convencion_temporal", "calidad", "completitud", "frescura", "criterio", "elegible", "estado", "motivos", "estimaciones", "trazabilidad", "advertencia"],
  "properties": {
    "version_contrato": {"const": "1.0"}, "modo": {"enum": ["actual", "historico"]},
    "modelo": {"type": "string"}, "modelo_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "estaciones": {"type": "array"}, "hora_observacion_original": {"type": "string"},
    "adquisicion_utc": {"type": ["string", "null"]}, "convencion_temporal": {"type": "object"},
    "calidad": {"enum": ["pendiente", "valida", "invalida"]}, "completitud": {"type": "boolean"},
    "frescura": {"type": "object"}, "criterio": {"enum": ["desconocido", "activo", "inactivo"]},
    "elegible": {"type": "boolean"},
    "estado": {"enum": ["estimacion_disponible", "antecedentes_incompletos_o_invalidos", "datos_obsoletos", "fallo_adquisicion", "compatibilidad_temporal_pendiente", "evento_activo", "adquisicion_futura_invalida", "adquisicion_utc_invalida", "fecha_adquisicion_pendiente", "politica_frescura_pendiente"]},
    "motivos": {"type": "array", "items": {"type": "string"}},
    "estimaciones": {
      "type": "object", "required": ["1", "3", "6", "8", "12", "24"], "additionalProperties": false,
      "properties": {"1": {"$ref": "#/$defs/p"}, "3": {"$ref": "#/$defs/p"}, "6": {"$ref": "#/$defs/p"}, "8": {"$ref": "#/$defs/p"}, "12": {"$ref": "#/$defs/p"}, "24": {"$ref": "#/$defs/p"}}
    },
    "trazabilidad": {"type": "object"}, "advertencia": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"elegible": {"const": false}}}, "then": {"properties": {"estimaciones": {"additionalProperties": {"type": "null"}, "properties": {"1": {"type": "null"}, "3": {"type": "null"}, "6": {"type": "null"}, "8": {"type": "null"}, "12": {"type": "null"}, "24": {"type": "null"}}}}}},
    {"if": {"properties": {"elegible": {"const": true}}}, "then": {"properties": {"estado": {"const": "estimacion_disponible"}, "criterio": {"const": "inactivo"}, "completitud": {"const": true}}}}
  ],
  "$defs": {"p": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}
}
